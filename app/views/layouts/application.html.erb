<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "StageManager · FAFAR" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Controle de palco, cronômetro e apresentações da Faculdade de Farmácia da UFMG.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Stagemanager">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= favicon_link_tag 'icon.ico' %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "farmacia-ds.min", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-fafar-theme="institucional" class="<%= content_for(:body_class) %>">
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <% if flash.any? %>
      <div class="flash-stack" aria-live="polite">
        <% flash.each do |type, message| %>
          <div class="feedback <%= type.to_s == 'alert' ? 'feedback-danger' : 'feedback-success' %>" role="status">
            <%= fafar_icon(type.to_s == 'alert' ? 'alert' : 'check', class_name: 'mt-1') %>
            <span><%= message %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
