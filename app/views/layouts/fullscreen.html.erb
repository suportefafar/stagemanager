<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Exibição · StageManager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= favicon_link_tag 'icon.ico' %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "farmacia-ds.min", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-fafar-theme="institucional" class="display-page <%= content_for(:body_class) %>">
    <a class="skip-link" href="#conteudo">Pular para a exibição</a>
    <main id="conteudo" class="display-content" tabindex="-1">
      <%= yield %>
    </main>
  </body>
</html>
