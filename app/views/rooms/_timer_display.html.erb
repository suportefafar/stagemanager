<div id="timer_display">
  <%
    remaining = room.timer_remaining.to_i
    is_negative = remaining < 0
    abs_remaining = remaining.abs
    minutes = abs_remaining / 60
    seconds = abs_remaining % 60
    sign = is_negative ? "-" : ""
    formatted = "#{sign}#{minutes.to_s.rjust(2, '0')}:#{seconds.to_s.rjust(2, '0')}"

    duration = room.timer_duration.to_i
    if duration > 0
      percentage = (remaining.to_f / duration * 100).clamp(0, 100)
    else
      percentage = 100
    end

    bar_class = if percentage > 50
      "bg-success"
    elsif percentage > 20
      "bg-warning"
    else
      "bg-danger"
    end

    status_label = { "playing" => "Em andamento", "paused" => "Pausado", "stopped" => "Parado" }.fetch(room.timer_status, "Parado")
    status_class = { "playing" => "status-success", "paused" => "status-warning", "stopped" => "status-neutral" }.fetch(room.timer_status, "status-neutral")
  %>

  <div class="timer-meta">
    <span class="status-badge <%= status_class %>"><%= status_label %></span>
    <span class="small text-body-secondary"><%= percentage.round %>% restante</span>
  </div>

  <div class="clock-text w-100 text-center" role="timer" aria-label="Tempo restante: <%= formatted %>"><%= formatted %></div>

  <div class="progress timer-progress mt-3" role="progressbar" aria-label="Progresso do cronômetro" aria-valuenow="<%= percentage.round %>" aria-valuemin="0" aria-valuemax="100">
    <div class="progress-bar <%= bar_class %>" style="width: <%= percentage %>%"></div>
  </div>
</div>
