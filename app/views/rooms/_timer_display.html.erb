<div id="timer_display">
  <%
    remaining = room.timer_remaining.to_i
    is_negative = remaining < 0
    abs_remaining = remaining.abs
    minutes = abs_remaining / 60
    seconds = abs_remaining % 60
    sign = is_negative ? "-" : ""
    formatted = "#{sign}#{minutes.to_s.rjust(2, '0')}:#{seconds.to_s.rjust(2, '0')}"

    duration = room.timer_duration.to_i
    if duration > 0
      percentage = (remaining.to_f / duration * 100).clamp(0, 100)
    else
      percentage = 100
    end

    if percentage > 50
      bar_class = "bg-success"
    elsif percentage > 20
      bar_class = "bg-warning"
    else
      bar_class = "bg-danger"
    end
  %>

  <div class="clock-text w-100 text-center">
    <%= formatted %>
  </div>

  <div class="progress mt-3" style="height: 10px; border-radius: 0;">
    <div class="progress-bar <%= bar_class %>" role="progressbar" style="width: <%= percentage %>%"></div>
  </div>
</div>
