<div id="media_panel">
  <div class="media-workspace mb-4">
    <section aria-labelledby="preview-title">
      <div class="d-flex align-items-end justify-content-between gap-3 mb-3">
        <div>
          <p class="eyebrow mb-1">Saída de apresentação</p>
          <h3 class="h6 mb-0" id="preview-title">Navegação e prévia</h3>
        </div>
        <% if room.total_slides.positive? %>
          <span class="status-badge status-info">Slide <%= room.current_slide %> de <%= room.total_slides %></span>
        <% end %>
      </div>

      <% if room.total_slides.positive? %>
        <div class="media-navigation mb-3" aria-label="Navegar pelos slides">
          <%= button_to update_slide_room_path(room.passcode, action_type: "prev"),
              method: :patch,
              class: "btn btn-outline-dark d-inline-flex align-items-center gap-2",
              disabled: room.current_slide <= 1 do %>
            <%= fafar_icon "arrow-left" %>Anterior
          <% end %>
          <span class="media-counter" aria-live="polite"><%= room.current_slide %> / <%= room.total_slides %></span>
          <%= button_to update_slide_room_path(room.passcode, action_type: "next"),
              method: :patch,
              class: "btn btn-outline-dark d-inline-flex align-items-center gap-2",
              disabled: room.current_slide >= room.total_slides do %>
            Próximo<%= fafar_icon "arrow-right" %>
          <% end %>
        </div>

        <div class="media-preview-frame">
          <% current_asset = room.current_media_asset %>
          <% if current_asset&.file&.attached? && current_asset.image? %>
            <%= image_tag url_for(current_asset.file), alt: current_asset.title.presence || "Prévia do slide #{room.current_slide}" %>
          <% elsif current_asset&.file&.attached? && current_asset.video? %>
            <video src="<%= url_for(current_asset.file) %>" muted autoplay <%= "loop" if current_asset.loop? %> aria-label="Prévia do vídeo <%= current_asset.title.presence || room.current_slide %>"></video>
          <% else %>
            <div class="media-preview-empty">
              <%= fafar_icon "monitor" %>
              <span>Não foi possível gerar a prévia deste item.</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="media-preview-frame">
          <div class="media-preview-empty">
            <%= fafar_icon "monitor" %>
            <strong class="text-white">Nenhum slide carregado</strong>
            <span class="small">Envie uma imagem ou um vídeo para iniciar a apresentação.</span>
          </div>
        </div>
      <% end %>

      <% if room.current_audio %>
        <div class="feedback feedback-success mt-3" role="status">
          <%= fafar_icon "check", class_name: "mt-1" %>
          <div class="min-w-0">
            <strong class="d-block">Áudio em reprodução</strong>
            <span class="small"><%= room.current_audio.title.presence || room.current_audio.file.filename %></span>
          </div>
          <%= button_to "Parar áudio",
              update_audio_room_path(room.passcode, action_type: "stop"),
              method: :patch,
              class: "btn btn-sm btn-outline-dark ms-auto" %>
        </div>
      <% end %>
    </section>

    <aside class="upload-zone" aria-labelledby="upload-title">
      <p class="eyebrow mb-1">Adicionar conteúdo</p>
      <h3 class="h6 mb-2" id="upload-title">Enviar arquivos</h3>
      <p class="small text-body-secondary mb-4">Imagens e vídeos entram na sequência de slides. Arquivos de áudio ficam disponíveis como trilha.</p>

      <%= form_with url: room_media_assets_path(room.passcode), method: :post, multipart: true do |f| %>
        <div class="mb-3">
          <%= f.label :files, "Arquivos de mídia", class: "form-label field-required" %>
          <%= f.file_field :files,
              multiple: true,
              accept: "image/*,video/*,audio/*",
              class: "form-control",
              name: "media_asset[files][]",
              required: true,
              aria: { describedby: "media-help" } %>
          <div class="form-text" id="media-help">Você pode selecionar vários arquivos de uma vez.</div>
        </div>
        <%= f.submit "Enviar arquivos", class: "btn btn-brand w-100" %>
      <% end %>
    </aside>
  </div>

  <div class="media-collections">
    <section class="panel shadow-none" aria-labelledby="slides-title">
      <header class="panel-header d-flex align-items-center justify-content-between gap-2">
        <div><p class="eyebrow mb-1">Sequência visual</p><h3 class="h6 mb-0" id="slides-title">Slides</h3></div>
        <span class="counter" aria-label="<%= room.total_slides %> slides"><%= room.total_slides %></span>
      </header>

      <ol class="media-list">
        <% room.media_assets.slides.each_with_index do |asset, index| %>
          <li class="media-item <%= 'is-active' if index + 1 == room.current_slide %>" data-controller="inline-edit">
            <span class="media-position" aria-label="Posição <%= index + 1 %>"><%= index + 1 %></span>

            <span class="media-thumb" aria-hidden="true">
              <% if asset.image? %>
                <%= image_tag url_for(asset.file), alt: "" %>
              <% else %>
                <%= fafar_icon "monitor" %>
              <% end %>
            </span>

            <span class="media-item-copy" data-inline-edit-target="label">
              <strong class="media-item-title" title="<%= asset.title.presence || asset.file.filename %>"><%= asset.title.presence || asset.file.filename %></strong>
              <span class="media-item-type"><%= asset.image? ? "Imagem" : "Vídeo" %><%= " · em repetição" if asset.video? && asset.loop? %></span>
            </span>

            <button class="btn btn-sm btn-icon btn-outline-dark" type="button" title="Renomear" aria-label="Renomear <%= asset.title.presence || asset.file.filename %>" data-inline-edit-target="trigger" data-action="inline-edit#open">
              <%= fafar_icon "edit" %>
            </button>

            <%= form_with url: room_media_asset_path(room.passcode, asset), method: :patch, class: "media-inline-form d-none", data: { inline_edit_target: "form" } do |f| %>
              <%= f.label :title, "Novo nome", class: "visually-hidden" %>
              <%= f.text_field :title,
                  value: asset.title.presence || asset.file.filename.to_s.sub(/\.[^.]+$/, ""),
                  class: "form-control form-control-sm",
                  name: "media_asset[title]",
                  data: { inline_edit_target: "input", action: "blur->inline-edit#submit keydown->inline-edit#keydown" } %>
            <% end %>

            <div class="media-item-actions">
              <% if asset.video? %>
                <%= button_to asset.loop? ? "Repetindo" : "Repetir",
                    room_media_asset_path(room.passcode, asset),
                    method: :patch,
                    params: { media_asset: { loop: !asset.loop } },
                    class: "btn btn-sm #{asset.loop? ? 'btn-charcoal' : 'btn-outline-dark'}",
                    title: asset.loop? ? "Desativar repetição" : "Ativar repetição" %>
              <% end %>
              <%= button_to "Exibir",
                  update_slide_room_path(room.passcode, action_type: "goto", slide_number: index + 1),
                  method: :patch,
                  class: "btn btn-sm #{index + 1 == room.current_slide ? 'btn-brand' : 'btn-outline-primary'}",
                  disabled: index + 1 == room.current_slide %>
              <%= button_to room_media_asset_path(room.passcode, asset),
                  method: :delete,
                  class: "btn btn-sm btn-icon btn-outline-danger",
                  data: { turbo_confirm: "Remover este slide?" },
                  title: "Excluir",
                  aria: { label: "Excluir #{asset.title.presence || asset.file.filename}" } do %>
                <%= fafar_icon "trash" %>
              <% end %>
            </div>
          </li>
        <% end %>

        <% if room.media_assets.slides.empty? %>
          <li class="media-preview-empty py-4 text-body-secondary">
            <%= fafar_icon "inbox" %>
            <span class="small">Nenhum slide foi enviado.</span>
          </li>
        <% end %>
      </ol>
    </section>

    <% audios = room.media_assets.audios %>
    <section class="panel shadow-none" aria-labelledby="audios-title">
      <header class="panel-header d-flex align-items-center justify-content-between gap-2">
        <div><p class="eyebrow mb-1">Trilha sonora</p><h3 class="h6 mb-0" id="audios-title">Arquivos de áudio</h3></div>
        <span class="counter" aria-label="<%= audios.size %> arquivos de áudio"><%= audios.size %></span>
      </header>

      <ul class="media-list list-unstyled">
        <% audios.each do |asset| %>
          <li class="media-item <%= 'is-active' if room.current_audio_id == asset.id %>" data-controller="inline-edit">
            <span class="media-thumb media-thumb--audio" aria-hidden="true"><%= fafar_icon "file" %></span>

            <span class="media-item-copy" data-inline-edit-target="label">
              <strong class="media-item-title" title="<%= asset.title.presence || asset.file.filename %>"><%= asset.title.presence || asset.file.filename %></strong>
              <span class="media-item-type">Áudio<%= " · em repetição" if asset.loop? %></span>
            </span>

            <button class="btn btn-sm btn-icon btn-outline-dark" type="button" title="Renomear" aria-label="Renomear <%= asset.title.presence || asset.file.filename %>" data-inline-edit-target="trigger" data-action="inline-edit#open">
              <%= fafar_icon "edit" %>
            </button>

            <%= form_with url: room_media_asset_path(room.passcode, asset), method: :patch, class: "media-inline-form d-none", data: { inline_edit_target: "form" } do |f| %>
              <%= f.label :title, "Novo nome", class: "visually-hidden" %>
              <%= f.text_field :title,
                  value: asset.title.presence || asset.file.filename.to_s.sub(/\.[^.]+$/, ""),
                  class: "form-control form-control-sm",
                  name: "media_asset[title]",
                  data: { inline_edit_target: "input", action: "blur->inline-edit#submit keydown->inline-edit#keydown" } %>
            <% end %>

            <div class="media-item-actions">
              <%= button_to asset.loop? ? "Repetindo" : "Repetir",
                  room_media_asset_path(room.passcode, asset),
                  method: :patch,
                  params: { media_asset: { loop: !asset.loop } },
                  class: "btn btn-sm #{asset.loop? ? 'btn-charcoal' : 'btn-outline-dark'}",
                  title: asset.loop? ? "Desativar repetição" : "Ativar repetição" %>

              <% if room.current_audio_id == asset.id %>
                <%= button_to "Parar", update_audio_room_path(room.passcode, action_type: "stop"), method: :patch, class: "btn btn-sm btn-outline-danger" %>
              <% else %>
                <%
                  confirm_message = if room.video_playing?
                    "Há um vídeo em reprodução. O áudio pode se sobrepor ao som do vídeo. Continuar?"
                  end
                %>
                <%= button_to "Reproduzir",
                    update_audio_room_path(room.passcode, action_type: "play", audio_id: asset.id),
                    method: :patch,
                    class: "btn btn-sm btn-outline-primary",
                    data: confirm_message ? { turbo_confirm: confirm_message } : {} %>
              <% end %>

              <%= button_to room_media_asset_path(room.passcode, asset),
                  method: :delete,
                  class: "btn btn-sm btn-icon btn-outline-danger",
                  data: { turbo_confirm: "Remover este áudio?" },
                  title: "Excluir",
                  aria: { label: "Excluir #{asset.title.presence || asset.file.filename}" } do %>
                <%= fafar_icon "trash" %>
              <% end %>
            </div>
          </li>
        <% end %>

        <% if audios.empty? %>
          <li class="media-preview-empty py-4 text-body-secondary">
            <%= fafar_icon "inbox" %>
            <span class="small">Nenhuma faixa de áudio foi enviada.</span>
          </li>
        <% end %>
      </ul>
    </section>
  </div>
</div>
