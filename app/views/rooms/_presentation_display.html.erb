<div id="presentation_display" class="presentation-screen">
  <% current_asset = room.current_media_asset %>
  <% if current_asset&.file&.attached? %>
    <% if current_asset.image? %>
      <%= image_tag url_for(current_asset.file),
          alt: current_asset.title.presence || "Slide #{room.current_slide}" %>
    <% elsif current_asset.video? %>
      <video src="<%= url_for(current_asset.file) %>" autoplay <%= 'loop' if current_asset.loop? %>
        aria-label="Vídeo <%= current_asset.title.presence || room.current_slide %>"></video>
    <% end %>
  <% else %>
    <div class="presentation-empty">
      <span class="presentation-empty-icon"><%= fafar_icon "monitor" %></span>
      <div>
        <p class="eyebrow text-white-50 mb-1">StageManager</p>
        <h1 class="h3 mb-2">Nenhuma apresentação ativa</h1>
        <p class="mb-0">O conteúdo aparecerá aqui assim que for selecionado no painel da sala.</p>
      </div>
    </div>
  <% end %>
</div>
