<%= turbo_stream_from "room_#{@room.id}_timer" %>
<%= turbo_stream_from "room_#{@room.id}_message" %>

<% content_for :title, "Cronômetro · #{@room.passcode} · StageManager" %>
<% content_for :body_class, "timer-display-page" %>

<section class="timer-screen" aria-label="Cronômetro da sala <%= @room.passcode %>">
  <%= render "rooms/timer_display", room: @room %>
</section>

<%= render "rooms/carousel_message", room: @room %>
