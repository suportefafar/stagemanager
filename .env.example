# Runtime settings for Stagemanager. Replace every __REQUIRED__ value locally.
RAILS_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
JOB_CONCURRENCY=1
PORT=80
RAILS_MASTER_KEY=__REQUIRED__
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_USER=__REQUIRED__
POSTGRES_PASSWORD=__REQUIRED__
STAGEMANAGER_DB_NAME=stagemanager_production
STAGEMANAGER_CACHE_DB_NAME=stagemanager_production_cache
STAGEMANAGER_QUEUE_DB_NAME=stagemanager_production_queue
STAGEMANAGER_CABLE_DB_NAME=stagemanager_production_cable
